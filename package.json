{
  "name": "monfily",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=@monfily/frontend",
    "build": "npm run build --workspace=@monfily/frontend",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "check": "npm run check --workspaces --if-present",
    "test:agent-readiness": "npm run build && node --test tests/agent-readiness.test.mjs",
    "clean": "rimraf node_modules dist frontend/node_modules shared/node_modules",
    "install:all": "npm install"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "5.6.3",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
